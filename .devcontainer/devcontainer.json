{
  "name": "NEXUS Research Engine",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "forwardPorts": [8000],
  "postCreateCommand": "pip install fastapi uvicorn",
  "postStartCommand": "python -m uvicorn server:app --host 0.0.0.0 --port 8000",
  "portsAttributes": {
    "8000": {
      "label": "NEXUS Dashboard",
      "onAutoForward": "openBrowser"
    }
  }
}
